# Python
.venv/
__pycache__/
*.pyc

# Downloaded models (re-fetch with pipeline/fetch_models.sh)
models/

# Remotion / node
studio/node_modules/
studio/out/
studio/.remotion/
studio/public/current/

# Intermediate renders (final.mp4 and thumbnail are kept)
videos/*/render/frames/
videos/*/render/video-only.mp4

# Regenerated in seconds by `build.py --from sound`; the final mix is inside final.mp4
videos/*/assets/score.wav
videos/*/assets/mix.wav

# Work-in-progress cuts stay out of git (~45 MB each). `git add -f` the one Nick approves.
videos/*/render/final.mp4

# Long-form specials: same rules as videos/, plus news articles read for a special are quoted,
# not redistributed. Local copies used by the fact gate stay out of git.
specials/*/render/frames/
specials/*/render/video-only.mp4
specials/*/assets/score.wav
specials/*/assets/mix.wav
specials/*/render/final.mp4
specials/*/source/news/
